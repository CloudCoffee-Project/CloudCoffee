          {
            "internalToken": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearPreferencia"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resultado persistido; consultar reglas en payment-service.md.",
