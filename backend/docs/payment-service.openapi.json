            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "iniciarPagoSandbox",
        "summary": "Order inicia un checkout con el total definitivo",
        "description": "Contrato objetivo INT2-113. Solo CLIENTE propietario. Revisión y reservas resueltas. No acepta escenario, monto ni URL. Misma intención no crea otro pago.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IniciarPago"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resultado persistido; consultar reglas en payment-service.md.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Idempotency-Replayed": {
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagoSandbox"
                },
                "example": {
                  "pagoId": "90000000-0000-4000-8000-000000000001",
                  "compraId": "30000000-0000-4000-8000-000000000001",
                  "estado": "pendiente",
                  "motivo": "esperando_proveedor",
                  "montoTotal": 4800,
                  "moneda": "CLP",
                  "simulado": false,
                  "proveedor": "mercadopago_sandbox",
                  "creadoAt": "2026-11-13T15:01:00Z",
                  "actualizadoAt": "2026-11-13T15:01:00Z",
                  "version": 1,
                  "paymentId": "91000000-0000-4000-8000-000000000001",
                  "preferenciaId": "sandbox-preference-001",
                  "initPoint": "https://sandbox.mercadopago.cl/checkout/v1/redirect?pref_id=sandbox-preference-001",
                  "entorno": "sandbox",
                  "expiraAt": "2026-11-13T15:15:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details HTTP 400.",
