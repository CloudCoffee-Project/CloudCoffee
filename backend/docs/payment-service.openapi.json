    "/v1/payments/webhooks/mercadopago": {
      "post": {
        "operationId": "recibirNotificacionMercadoPago",
        "summary": "Recibir una notificación autenticada y persistir inbox",
        "description": "Firma HMAC verificada por INT2-112 (x-signature ts/v1 sobre id:data.id;request-id:x-request-id;ts:ts;), no por JWT. La consulta posterior al proveedor valida referencia, total, moneda y entorno. Sin proveedor o sin secreto configurado responde 503 PAYMENT_NOT_ENABLED sin efectos; firma inválida 401 FIRMA_INVALIDA; cuerpo que no coincide con data.id firmado 400 NOTIFICACION_INVALIDA.",
        "security": [
          {
            "webhookSignature": [],
            "webhookRequestId": []
          }
        ],
        "parameters": [
          {
            "name": "data.id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "const": "payment"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Webhook"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Notificación autenticada persistida durablemente."
          },
          "200": {
            "description": "Duplicado ya persistido; sin repetir efectos."
          },
          "400": {
            "description": "Problem Details HTTP 400.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details HTTP 401.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details HTTP 503.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Segundos antes de reconsultar la misma intención."
              }
            }
          }
        }
      }
    }
