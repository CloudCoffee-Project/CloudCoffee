{
  "openapi": "3.1.0",
  "info": {
    "title": "CloudCoffee · Payment y checkout sandbox",
    "version": "2.0.0",
    "description": "Contrato objetivo INT2-108; ejecución INT2-111/112/113. No describe endpoints ya disponibles. Histórico del simulador en compra-pago-retiro.openapi.json."
  },
  "servers": [
    {
      "url": "/",
      "description": "Rutas /v1 vía Gateway; /internal solo conexión privada a Payment."
    }
  ],
  "paths": {
    "/v1/compras/{compraId}/pago": {
      "parameters": [
