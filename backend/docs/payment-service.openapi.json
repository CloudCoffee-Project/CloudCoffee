  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT RS256"
      },
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Service-Token"
      },
      "webhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-signature",
        "description": "HMAC del proveedor; validación detallada en payment-service.md."
      },
      "webhookRequestId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-request-id"
      }
    },
    "schemas": {
      "CanalRetorno": {
        "type": "string",
        "enum": [
          "web",
          "mobile"
        ]
      },
      "IniciarPago": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "canalRetorno": {
            "$ref": "#/components/schemas/CanalRetorno"
          }
        },
        "required": [
          "canalRetorno"
        ]
      },
      "ItemPreferencia": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordenId": {
            "type": "string",
            "format": "uuid"
          },
          "ofertaId": {
            "type": "string",
            "format": "uuid"
          },
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "precioUnitario": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000000000
          }
        },
        "required": [
          "ordenId",
          "ofertaId",
          "titulo",
          "cantidad",
          "precioUnitario"
        ]
      },
      "CrearPreferencia": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "compraId": {
            "type": "string",
            "format": "uuid"
          },
          "clienteId": {
            "type": "string",
            "format": "uuid"
          },
          "montoTotal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000000000
          },
          "moneda": {
            "const": "CLP"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ItemPreferencia"
            }
          },
          "canalRetorno": {
            "$ref": "#/components/schemas/CanalRetorno"
          },
          "expiraAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "compraId",
          "clienteId",
          "montoTotal",
          "moneda",
          "items",
          "canalRetorno",
          "expiraAt"
        ],
        "examples": [
          {
            "compraId": "30000000-0000-4000-8000-000000000001",
            "clienteId": "10000000-0000-4000-8000-000000000001",
            "montoTotal": 4800,
            "moneda": "CLP",
            "items": [
              {
                "ordenId": "40000000-0000-4000-8000-000000000001",
                "ofertaId": "50000000-0000-4000-8000-000000000001",
                "titulo": "Café americano",
                "cantidad": 2,
                "precioUnitario": 1800
              },
              {
                "ordenId": "40000000-0000-4000-8000-000000000002",
                "ofertaId": "50000000-0000-4000-8000-000000000002",
                "titulo": "Té",
                "cantidad": 1,
                "precioUnitario": 1200
              }
            ],
            "canalRetorno": "web",
            "expiraAt": "2026-11-13T15:15:00Z"
          }
        ]
      },
      "Preferencia": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "compraId": {
            "type": "string",
            "format": "uuid"
          },
          "clienteId": {
            "type": "string",
            "format": "uuid"
          },
          "preferenciaId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "referenciaExterna": {
            "type": "string",
            "minLength": 1
          },
          "estado": {
            "type": "string",
            "enum": [
              "pendiente",
              "aprobado",
              "rechazado",
              "cancelado",
              "vencido",
              "requiere_conciliacion"
            ]
          },
          "montoTotal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000000000
          },
          "moneda": {
            "const": "CLP"
          },
          "entorno": {
            "const": "sandbox"
          },
          "initPoint": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
