# URL base del API Gateway. Apunta al despliegue público; antes se usaba una
# IP LAN. El WebSocket se deriva de acá con el path /v1/notifications/ws.
EXPO_PUBLIC_API_URL=https://api-cloudcoffee.inf.uct.cl

# Correo del administrador que usa el botón "Avisar al administrador".
EXPO_PUBLIC_ADMIN_EMAIL=administrador@cloudcoffee.dev
