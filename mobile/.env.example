# URL base del API Gateway. Si se omite, la app usa por defecto:
#   Android (emulador): http://10.0.2.2:18080
#   iOS / Web:          http://localhost:18080
EXPO_PUBLIC_API_URL=http://localhost:18080

# Correo del administrador que usa el botón "Avisar al administrador".
EXPO_PUBLIC_ADMIN_EMAIL=administrador@cloudcoffee.dev
