# RabbitMQ
RABBITMQ_USER=cloudcoffee
RABBITMQ_PASSWORD=cloudcoffee_local

# Auth
AUTH_DB_NAME=cloudcoffee_auth
AUTH_DB_USER=cloudcoffee_auth
AUTH_DB_PASSWORD=auth_local_password
AUTH_DB_PORT=15432
AUTH_SERVICE_PORT=18081
# Solo desarrollo: "docker,dev" carga las cuentas de prueba (INT2-65).
# En cualquier otro entorno dejar "docker" para no crear cuentas conocidas.
AUTH_SPRING_PROFILES=docker,dev
# INT2-65/INT2-50: token compartido para consultas internas entre servicios
# (mínimo 32 caracteres). En producción generar uno propio, por ejemplo con
# `openssl rand -hex 32`, y no reutilizar este valor de desarrollo.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-cambiar-0123456789

# Catalog
CATALOG_DB_NAME=cloudcoffee_catalog
CATALOG_DB_USER=cloudcoffee_catalog
CATALOG_DB_PASSWORD=catalog_local_password
CATALOG_DB_PORT=15433
CATALOG_SERVICE_PORT=18082
# Solo desarrollo: "docker,dev" carga el seed del catálogo (INT2-36).
# En cualquier otro entorno dejar "docker" para no cargar datos de prueba.
CATALOG_SPRING_PROFILES=docker,dev

# Order
ORDER_DB_NAME=cloudcoffee_order
ORDER_DB_USER=cloudcoffee_order
ORDER_DB_PASSWORD=order_local_password
ORDER_DB_PORT=15434
ORDER_SERVICE_PORT=18083
# Solo desarrollo: "docker,dev" carga las compras de prueba (INT2-76).
# En cualquier otro entorno dejar "docker" para no cargar datos de prueba.
ORDER_SPRING_PROFILES=docker,dev

# Notification
NOTIFICATION_DB_NAME=cloudcoffee_notification
NOTIFICATION_DB_USER=cloudcoffee_notification
NOTIFICATION_DB_PASSWORD=notification_local_password
NOTIFICATION_DB_PORT=15435
NOTIFICATION_SERVICE_PORT=18084

# Gateway
API_GATEWAY_PORT=18080
# Orígenes del frontend local; reemplazar por el dominio HTTPS del frontend en produccion.
# Para varios origenes, separarlos por comas. No se permiten comodines.
# 8081 → Expo web (expo start --web), 3000 → web de Vite.
#
# Los de localhost y 127.0.0.1 alcanzan para trabajar en el navegador del mismo PC.
# Para abrir la app web desde el celular hay que sumar el origen con tu IP de LAN
# (la que muestra `ip -4 addr show scope global` en Linux, `ipconfig getifaddr
# en0` en macOS), porque el gateway no acepta comodines y el origen tiene que
# coincidir exacto:
#   CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.10:8081,http://localhost:3000
# ↑
#                   ↑ reemplaza 192.168.1.10 por la tuya; se cambia al cambiar de red
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000

# Trazabilidad distribuida local. 1.0 exporta todas las trazas a Zipkin.
TRACING_SAMPLING_PROBABILITY=1.0

# INT2-16: cuotas del Gateway por IP, independientes para cada endpoint.
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_REFILL_PERIOD=PT1M
RATE_LIMIT_PASSWORD_RECOVERY_CAPACITY=3
RATE_LIMIT_PASSWORD_RECOVERY_REFILL_PERIOD=PT15M
RATE_LIMIT_VERIFICATION_RESEND_CAPACITY=3
RATE_LIMIT_VERIFICATION_RESEND_REFILL_PERIOD=PT15M

# Archivos PEM externos al contexto de build backend. Generarlos antes de iniciar.
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem

# INT2-31: habilitar solo en desarrollo y reiniciar Gateway, Auth y Catalog.
# OPENAPI_ENABLED=true
OPENAPI_ENABLED=false
